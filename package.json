{
  "name": "nof1-experiments",
  "version": "1.0.0",
  "description": "Private N-of-1 self-tracking for user-chosen interventions",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "release:check": "node scripts/validate-app-store-release.js && npm run lint && npm run typecheck && npm test -- --runInBand && npx expo-doctor",
    "eas-build-pre-install": "node scripts/validate-release-env.js",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "build:ios-simulator": "eas build --profile development --platform ios --local",
    "build:android-emulator": "eas build --profile preview --platform android --local",
    "build:ios-cloud": "eas build --profile development --platform ios",
    "build:ios-local": "PATH=\"$(ruby -e 'require \\\"rubygems\\\"; print Gem.user_dir')/bin:/usr/local/bin:/opt/homebrew/bin:$PATH\" && eas build --platform ios --profile development --local",
    "build:android-cloud": "eas build --profile preview --platform android"
  },
  "dependencies": {
    "@clerk/expo": "^4.6.2",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "convex": "^1.17.4",
    "expo": "^57.0.19",
    "expo-asset": "~57.0.16",
    "expo-build-properties": "~57.0.16",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-linear-gradient": "~57.0.1",
    "expo-notifications": "~57.0.16",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-purchases": "^10.7.2",
    "react-native-purchases-ui": "^10.7.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.4",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  },
  "private": true
}
