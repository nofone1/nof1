{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "environment": "development",
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "development-simulator": {
      "extends": "development"
    },
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_SKIP_AUTH": "true"
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium",
        "image": "latest"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "skip-login": {
      "extends": "development",
      "env": {
        "EXPO_PUBLIC_SKIP_AUTH": "true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "anam@revyl.ai",
        "ascAppId": "6758900172"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
