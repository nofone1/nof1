# Clerk frontend publishable key
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxx

# Convex deployment URL (e.g. https://your-deployment.convex.cloud)
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Optional future API base URL
EXPO_PUBLIC_API_BASE_URL=https://api.nof1experiments.com

# Auth bypass for local/dev and Revyl Release preview builds (baked at bundle time)
EXPO_PUBLIC_SKIP_AUTH=false

# RevenueCat public SDK keys. These are safe to ship in the app bundle.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_xxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_xxxxxxxxxxxxxxxxx

# RevenueCat Test Store key. When set it overrides the store keys above so
# dogfood and E2E builds purchase without real store accounts.
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=

# Public Whop application ID used to start the OAuth flow.
EXPO_PUBLIC_WHOP_APP_ID=

# Whop OAuth base URL. Keep the production default unless building against
# Whop's isolated sandbox environment.
EXPO_PUBLIC_WHOP_OAUTH_BASE_URL=https://api.whop.com/oauth

# Convex backend env (set in Convex dashboard / CLI)
# CLERK_JWT_ISSUER_DOMAIN should look like: https://clerk.your-domain.com
# Billing secrets are server-only and must never be EXPO_PUBLIC_*:
#   REVENUECAT_SECRET_API_KEY, REVENUECAT_WEBHOOK_AUTH,
#   REVENUECAT_WEBHOOK_SIGNING_SECRET, WHOP_APP_ID, WHOP_API_KEY,
#   WHOP_OAUTH_CLIENT_SECRET,
#   WHOP_WEBHOOK_SECRET, WHOP_PLUS_PRODUCT_ID
# WHOP_API_KEY is a company API key for membership reads.
# WHOP_OAUTH_CLIENT_SECRET is the app API key for OAuth token exchange.
# Sandbox configuration (not secrets):
#   WHOP_API_BASE_URL=https://sandbox-api.whop.com/api/v1
#   WHOP_OAUTH_BASE_URL=https://sandbox-api.whop.com/oauth
# See docs/billing-setup.md for the full dashboard checklist.
